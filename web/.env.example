# 웹 환경변수 예시. 실제 값은 web/.env.local(gitignore)에 넣는다.
# Vite는 VITE_ 접두사 변수만 클라이언트에 노출한다.

# ── 로컬 개발이 Cloud Run 백엔드를 바라보게 하기 (권장) ──
# dev 서버의 프록시 타겟만 Cloud Run으로 바꾼다. 브라우저는 localhost:5173만 호출 → CORS 불필요.
# 미설정 시 http://localhost:8080 (로컬 백엔드).
VITE_DEV_API_TARGET=https://readmind-backend-53543020852.asia-northeast3.run.app

# ── 정적 호스팅(프로덕션)에서 브라우저가 백엔드를 직접 호출할 때만 사용 ──
# 절대 URL을 주면 프록시 대신 이 주소로 직접 fetch → 백엔드에 CORS 설정이 있어야 한다(현재 없음).
# 로컬 dev에서는 비워두고 위 VITE_DEV_API_TARGET + 프록시를 쓰는 걸 권장.
# VITE_API_BASE_URL=https://readmind-backend-53543020852.asia-northeast3.run.app/api/v1
