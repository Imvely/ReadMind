# ReadMind 환경변수 예시 (.env.example)
# 실제 값은 .env 에 채운다. .env 는 절대 커밋하지 않는다(.gitignore).
# 명세서 §10 핵심 키와 1:1 대응 + docker-compose 기동에 필요한 보조 키.

# ============ DB (PostgreSQL 16 + pgvector) ============
# 로컬 compose postgres 기본값. 클라우드 DB(Neon 등)를 쓰면 아래 "클라우드 DB" 블록 참조.
POSTGRES_USER=readmind
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=readmind
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# ai-service 가 쓰는 psycopg 형식 DSN. 클라우드는 sslmode=require 포함.
POSTGRES_URL=postgresql://readmind:change-me-postgres@postgres:5432/readmind

# ── 클라우드 DB(Neon 등) 사용 시 ─────────────────────────────────────────────
# 클라우드 Postgres 는 sslmode=require 필수. ai-service 는 POSTGRES_URL 에 그대로 포함:
#   POSTGRES_URL=postgresql://USER:PW@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require
# backend(Spring)는 JDBC 형식으로 별도 지정(설정 시 compose 기본 로컬값을 덮음). Flyway 는
# 세션 어드바이저리 락을 쓰므로 PgBouncer 풀러가 아닌 '다이렉트' 엔드포인트(호스트에서 -pooler 제거) 권장:
#   SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxx.REGION.aws.neon.tech/DB?sslmode=require
#   SPRING_DATASOURCE_USERNAME=USER
#   SPRING_DATASOURCE_PASSWORD=PW
# 스키마는 Flyway V1__init.sql 로 적용(앱 기동 시 자동, 또는 flyway/flyway 도커 CLI 로 수동).

# ============ Redis 7 ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ============ S3 호환 스토리지 (MinIO 로컬) ============
S3_ENDPOINT=http://minio:9000
S3_BUCKET=readmind
S3_KEY=minioadmin
S3_SECRET=change-me-minio
S3_REGION=us-east-1
# MinIO 루트 자격증명 (minio 컨테이너 기동용; S3_KEY/S3_SECRET 와 일치시킨다)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio

# ============ auth (JWT) ============
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# ============ 배포(엣지 Caddy) ============
# 실제 도메인을 넣으면 Caddy 가 Let's Encrypt 인증서를 자동 발급(80/443 공개).
# 로컬 확인은 localhost(내부 CA). 웹은 same-origin 으로 /api 를 호출하므로 CORS 불필요.
APP_DOMAIN=localhost
# 주의(스토리지): presigned URL 은 브라우저가 S3_ENDPOINT 로 직접 접속한다.
# 실배포에서는 S3_ENDPOINT 가 공개로 열려 있어야 한다(MinIO 를 공개 도메인에 노출하거나,
# 베타 권장: Cloudflare R2 / AWS S3 로 교체 — .env 값만 바꾸면 됨).

# ============ service-to-service ============
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TOKEN=change-me-service-token

# ============ LLM (provider 추상화 → 교체 가능) ============
# LLM_PROVIDER: commercial|selfhosted(OpenAI 호환, LLM_API_BASE 필요) | gemini(google-genai)
LLM_PROVIDER=commercial
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY=
# ── Gemini(LLM_PROVIDER=gemini) 전용 ──
#   LLM_MODEL=gemini-2.5-flash, LLM_API_KEY=<AI Studio 발급키> (기본 Developer API)
#   Vertex 를 쓸 때만 명시: GEMINI_VERTEXAI=true(Express) 또는 GEMINI_PROJECT(서비스계정)+GEMINI_LOCATION.
# GEMINI_VERTEXAI=
# GEMINI_PROJECT=
# GEMINI_LOCATION=global
# 임베딩 provider: 미설정 시 LLM_PROVIDER 를 따름. Gemini 는 gemini-embedding-001 을
#   output_dimensionality=EMBEDDING_DIM(1024)로 요청 → vector(1024) 스키마와 일치.
#   LLM_API_KEY 를 임베딩에도 재사용(EMBEDDING_API_KEY 미설정 시).
# EMBEDDING_PROVIDER=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1024

# ============ billing ============
BILLING_PROVIDER=toss
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=

# ============ quota (free tier 한도) ============
FREE_SUMMARY_PER_MONTH=10
FREE_QA_PER_MONTH=20
FREE_TRANSLATE_PER_MONTH=10
FREE_STORAGE_MB=200
READMIND_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/readmind
